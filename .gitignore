# Secrets — never commit these
.env
backend/.env
.dev.vars
.dev.vars.*

# Dependencies (tracked legacy — new installs should not be committed)
node_modules/
backend/node_modules/
.wrangler/

# Logs / OS junk
*.log
.DS_Store

# Python caches
__pycache__/
*.pyc

# Build artefact — generated at deploy time (see netlify.toml [build]).
# Keep a checked-in snapshot when available so a Cloudflare build can still
# publish the last good catalogue during a CAST outage; Netlify still refreshes
# it with the existing best-effort build command.
!data/corona-europe-catalog.json

# Geocoding cache written by tools/build-hungaricana-catalog.mjs —
# per-machine answers from Nominatim, never part of the catalogue.
data/other-maps/geocode-cache.json

# Local RVT configuration, COGs and cache must not be checked in
rvt_service/sources.json
rvt_service/cache/
*.tif
*.tiff
*.cog
