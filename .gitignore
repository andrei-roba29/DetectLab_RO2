# Secrets — never commit these
.env
backend/.env

# Dependencies (tracked legacy — new installs should not be committed)
node_modules/
backend/node_modules/

# Logs / OS junk
*.log
.DS_Store

# Python caches
__pycache__/
*.pyc

# Build artefacts — generated at deploy time (see netlify.toml [build]):
# the CORONA Europe catalogue snapshot is baked fresh on every deploy by
# tools/build-corona-europe-catalog.mjs.
data/corona-europe-catalog.json

# Geocoding cache written by tools/build-hungaricana-catalog.mjs —
# per-machine answers from Nominatim, never part of the catalogue.
data/other-maps/geocode-cache.json

# Local RVT configuration, COGs and cache must not be checked in
rvt_service/sources.json
rvt_service/cache/
*.tif
*.tiff
*.cog
