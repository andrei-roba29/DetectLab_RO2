# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated public frontend origins. These are trusted as Stripe
# success/cancel return targets; both DetectLab markets use the same API.
FRONTEND_ORIGINS=https://detectlab.ro,https://www.detectlab.ro,https://detectlab.eu,https://www.detectlab.eu

# --- Postgres / PostGIS ---
DATABASE_URL=postgresql://detectlab:detectlab@localhost:5432/detectlab
# Set to true for hosted providers that require SSL (Supabase, Railway, etc).
# Leave false for a local Postgres install.
PGSSL=false

# --- JWT ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Supabase (used to verify user tokens for the payments API) ---
# URL + anon key from your Supabase project (Settings → API). The anon
# key is public (it's already in js/supabase.js).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Persistent archaeological evidence ingestion ---
# Long random value required by ingestion/review administration endpoints.
INGESTION_ADMIN_KEY=change_me_to_a_long_random_ingestion_key
# Newsletter admin key — the same kind of gate as above, accepted by
# GET /api/newsletter/subscribers and POST /api/newsletter/send-first.
# Any of INGESTION_ADMIN_KEY / NEWSLETTER_ADMIN_KEY / ADMIN_KEY / ADMINKEY works.
# Unset ⇒ any authenticated user may list & send (dev/demo).
NEWSLETTER_ADMIN_KEY=change_me_to_a_long_random_newsletter_key
# Enable only on one backend instance to avoid unnecessary source traffic.
EVIDENCE_WORKER_ENABLED=false
# Conservative process-wide interval between biblioteca-digitala.ro requests.
BIBLIOTECA_REQUEST_INTERVAL_MS=1200
# One retry delay for a refused/rate-limited source response (HTTP 403/429/5xx).
# Shared hosting egress IPs hit the source's bot filter intermittently, so a
# short second attempt normally clears it.
BIBLIOTECA_RETRY_BACKOFF_MS=1500
# Wall-clock budget for the live crawl an interactive search triggers. The
# source is politely throttled, so an unbounded run can outlast the platform's
# HTTP timeout: the engine then answers with everything it already read,
# flagged `truncated`, and the locality is re-checked the same day.
EVIDENCE_RESEARCH_BUDGET_MS=45000
# Echo the underlying error text in failed evidence responses (staging only —
# production returns a coded error plus a request id that ties to the logs).
EVIDENCE_DEBUG=false
# --- SIRUTA import (npm run import:siruta) ---
# Official INS data.gov.ro source — always recorded as source_url in PostgreSQL.
# The importer fetches from SIRUTA_SOURCE_URL (defaults to the official URL).
SIRUTA_SOURCE_URL=https://data.gov.ro/dataset/fcba1a54-cffd-422c-b3ac-920f63564085/resource/0ab29d86-302c-4cfa-b9b9-fd5c7ff90710/download/siruta_s1_2025.csv
# SIRUTA_URL is a backwards-compatible alias for SIRUTA_SOURCE_URL.
# SIRUTA_SOURCE_URL takes precedence if both are set.
SIRUTA_URL=
SIRUTA_VERSION=S1 2025
# Supply a pre-downloaded SIRUTA CSV file path on the server.
# Resolution order: CLI argument > SIRUTA_CSV_PATH > SIRUTA_SOURCE_URL.
# The official data.gov.ro URL is still recorded as source_url regardless.
SIRUTA_CSV_PATH=
# Fetch timeout in milliseconds (default 30000).
SIRUTA_FETCH_TIMEOUT_MS=30000
# Number of retries for the fetch (default 3).
SIRUTA_FETCH_RETRIES=3

# --- Stripe (real payments — leave empty until you're ready to go live) ---
# Get keys at https://dashboard.stripe.com/apikeys (test/live).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Created by: STRIPE_SECRET_KEY=sk_test_xxx node scripts/setupStripe.js
#
# ONE-TIME €5 price — Premium for one calendar month, NO automatic
# renewal. This is what all new checkouts use (Checkout mode "payment").
STRIPE_ONE_TIME_PRICE_ID=price_xxx
# Legacy recurring €5/month price. Kept only for backwards compatibility:
# existing subscribers keep renewing, and it is used as a fallback when
# STRIPE_ONE_TIME_PRICE_ID is not set. Do not set it for new deployments.
STRIPE_PRICE_ID=price_xxx
# Fallback frontend origin used for Stripe's success/cancel redirects when a
# request has no trusted Origin. A trusted FRONTEND_ORIGINS value wins, keeping
# .ro customers on .ro and .eu customers on .eu.
STRIPE_SITE_URL=https://detectlab.ro

# --- ArcGIS source ---
ARCGIS_BASE_URL=https://eism.geo-spatial.ro/eismgeo/rest/services/Patrimoniu/PatrimoniuWM/MapServer
ARCGIS_PAGE_SIZE=1000
ARCGIS_CONCURRENCY=2
ARCGIS_REQUEST_TIMEOUT_MS=15000
ARCGIS_MAX_RETRIES=3

# Abort the whole sync (and keep serving old data) if we fetch fewer than
# this fraction of the expected feature count, even after retries.
SYNC_MIN_SUCCESS_RATIO=0.98

# --- Scheduling ---
SYNC_CRON="0 0 * * *"
SYNC_ON_BOOT=false

# ── Dataforsyningen (Denmark · Danmarks Højdemodel hillshade) ──────────────
# Token for api.dataforsyningen.dk, created at dataforsyningen.dk →
# "Administrer token til webservice og API'er" (32 hex characters).
# Used only by backend/src/routes/geoProxy.js (route /api/geo/dk-dhm), which
# adds it server-side as the "token" request header so it never reaches the
# browser. The same variable name is used by netlify/functions/dk-dhm.mjs.
# The layer consumes the WMTS dhm_terraen_skyggekort_DAF /
# dhm_overflade_skyggekort_DAF services (TileMatrixSet View1, EPSG:25832).
# Leave empty to disable the Denmark LiDAR layer (the proxy then answers 401
# and the map shows "Invalid or missing Dataforsyningen token").
DATAFORSYNINGEN_TOKEN=YOUR_TOKEN

# ── Lantmäteriet (Sweden · terrängskuggning from the national height model) ─
# "Markhöjdmodell Visning" is a LICENSED, fee-based product (Geotorget:
# 75 625 kr/year incl. VAT at the time of writing). Its access point
# https://maps.lantmateriet.se/hojdmodell/wms/v1.1 answers 401 without
# credentials. Order the product at https://geotorget.lantmateriet.se/ →
# "Markhöjdmodell Visning" → sign in → beställ behörighet; Lantmäteriet then
# issues a consumer account for the service.
#
# Used only by backend/src/routes/geoProxy.js (route /api/geo/se-hojdmodell),
# which adds the Authorization header server-side so it never reaches the
# browser. Leave empty to disable the Sweden LiDAR layer (the proxy then
# answers 401 and the map shows "Missing or invalid Lantmäteriet (Geotorget)
# credentials").
#
# Either a Basic-auth consumer account…
LANTMATERIET_WMS_USER=
LANTMATERIET_WMS_PASSWORD=
# …or an OAuth2 access token, if that is what your agreement issues:
LANTMATERIET_WMS_TOKEN=
# Optional override of the upstream access point:
# LANTMATERIET_WMS_URL=https://maps.lantmateriet.se/hojdmodell/wms/v1.1

# ── Denmark · GeoDanmark Ortofoto (Datafordeleren) ─────────────────────────
# The orthophoto base map of the Danish layers (js/danish-layers.config.js) is
# served by Datafordeleren to an identified service user ("Tjenestebruger"),
# created at https://selfservice.datafordeler.dk/ — a WEB user cannot read the
# WMS, and the service user must be given access to the GeoDanmarkOrto service.
# The credentials stay here, server-side: /api/geo/dk-orto adds them and the
# browser never sees them (netlify/functions/dk-orto.mjs, backend/src/routes/
# geoProxy.js). Leave empty to keep the orthophoto row switched off with its own
# explanation in the panel; the DTK25 and OpenStreetMap base maps keep working.
# Licence: CC BY 4.0, © Klimadatastyrelsen / GeoDanmark — see DATA_SOURCES.md.
DATAFORDELER_USER=
DATAFORDELER_PASSWORD=
