<?xml version="1.0" encoding="UTF-8"?>
<!-- SYNTHETIC test fixture — invented workspace:names under the real portal
     Titles, written for test-albania-asig-layers.js and tools/resolve_layers.py.
     It is NOT an ASIG response and must never be treated as one: it exists to
     exercise the resolver's four outcomes offline —
       unique Title match, local-Name fallback (25k_krgjsh_1),
       ambiguous Title (Water course link, twice) and missing Title
       (Mining Hazardous Areas (DCM 347), absent on purpose) —
     plus the Heritage archaeology keyword rule. -->
